# Copie para .env e ajuste. Todos os nomes correspondem aos campos de
# src/settings.py (classe Settings).

# --- Banco de dados ---
# DuckDB e embutido: o banco inteiro e um arquivo. Sem servidor, sem porta,
# sem credenciais.
DUCKDB_PATH=data/cnpj.duckdb
DUCKDB_THREADS=0               # 0 = o DuckDB decide
DUCKDB_MEMORY_LIMIT=           # ex.: 16GB. Vazio = 80% da RAM
DUCKDB_TEMP_DIRECTORY=         # onde ocorre o spill de operacoes grandes

# --- Versao alvo na Receita Federal ---
# Vazio = detectar a mais recente. Formato YYYY-MM.
TARGET_DATE=
# Base sem a data; troque so para um espelho. TARGET_DATE e anexado com "/".
RFB_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj/

# --- Download ---
MAX_WORKERS=4
# A concorrencia real do download e MAX_WORKERS x 2. Fixe aqui para sobrescrever.
# MAX_CONCURRENT_REQUESTS=8
# Threads da extracao de ZIP (esta parte usa ThreadPoolExecutor).
EXTRACT_WORKERS=2
DOWNLOAD_CHUNK_SIZE=8192
RATE_LIMIT_PER_SEC=0          # BYTES por segundo; 0 desativa. Valores abaixo de
                              # DOWNLOAD_CHUNK_SIZE travam o download por horas.
VERIFY_ZIP_INTEGRITY=true
IMPERSONATE=chrome110         # chrome | chrome110 | edge99 | safari15_3
# PROXIES=["http://user:pass@host:port", ...]
# PROXY_ROTATION_STRATEGY=round_robin   # round_robin | random
RETRY_MAX_ATTEMPTS=10
RETRY_BACKOFF_FACTOR=0.5

# --- Processamento ---
FILE_ENCODING=latin1
CHUNK_SIZE=200_000
STRIP_BOM=true

# --- Qualidade e integridade ---
AUTO_REPAIR_LEVEL=basic       # none | basic | aggressive
ENABLE_QUALITY_GATES=true
GATE_MAX_CHANGED_RATIO=0.3
GATE_MAX_NULL_DELTA_RATIO=0.3
GATE_MIN_ROWS=20
GATE_LOG_LEVEL=WARNING        # INFO | WARNING
STRICT_FK_VALIDATION=true
# Cria as linhas pai que faltam antes de carregar os filhos. Sem isso a carga
# aborta na primeira referencia orfa, porque a FK e verificada no INSERT.
ENABLE_CONSTRAINTS_BACKFILL=true
SKIP_INVALID_ESTABELECIMENTOS_CNPJ=false

# --- Schema ---
# Recria o schema do zero a cada carga. ATENCAO: o drop acontece antes de qualquer
# tabela ser lida, entao uma carga que nao terminar deixa o banco vazio. O padrao
# do codigo e false; aqui fica false por isso.
ALLOW_DROP=false

# --- Telemetria e quarentena ---
# Saida em logs/telemetry/<YYYYMMDD>/ e logs/quarantine/<YYYYMMDD>/ (UTC).
# Nao existe mais logs/auto_repair/: a telemetria foi para logs/telemetry/.
TELEMETRY_MAX_BYTES=10000000
QUARANTINE_MAX_BYTES=10000000
TELEMETRY_ROTATE_DAILY=true
QUARANTINE_ROTATE_DAILY=true

# --- Enriquecimento por CEP (perfil aggressive) ---
# O mapa e lido como texto e a chave e normalizada dos dois lados, entao um cep
# so com digitos no CSV nao quebra o merge. Zero a esquerda ainda importa.
ENABLE_CEP_ENRICHMENT=false
# CEP_MAP_PATH=./data/cep_map.csv
CEP_CORRECT_UF_ONLY_IF_NULL=true
# MUNICIPIO_NAME_MAP_PATH=./data/municipios_por_nome.csv

# --- Metricas (opcionais) ---
# ENABLE_METRICS_PROMETHEUS=true
# PROMETHEUS_METRICS_PATH=./logs/cnpj.prom
# ENABLE_PROMETHEUS_PUSH=false
# PROMETHEUS_PUSH_URL=
# PROMETHEUS_JOB=cnpj_auto_repair
# PROMETHEUS_INSTANCE=local
# ENABLE_OTLP_PUSH=false
# OTLP_ENDPOINT=

# --- Logging ---
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR