# ============================================================================
# Agent / AI tooling
# ============================================================================
# Contexto local de agentes: não versionar. QWEN.md e AGENTS.md são
# regenerated per-worktree e não descrevem o contrato do pipeline.
.qwen/
AGENTS.md
QWEN.md
CLAUDE.md
.cursor/
.aider*

# ============================================================================
# Dados e logs (gerados em tempo de execução)
# ============================================================================
# O banco DuckDB, os volumes extraídos, o ledger de resume e os arquivos de
# quarentena/telemetria. Tudo reproduzível a partir de `python -m src`.
/data/
/logs/

# Artefatos intermediários do manifest de run (data/manifest.json já cobre)
manifest.json.tmp

# ============================================================================
# Segredos
# ============================================================================
# .env.example é versionado de propósito; só o .env real sai.
/.env
.env.*
!.env.example

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
.venv/
.venv*/
venv/
env/
ENV/
.python-version

# Build / packaging
build/
dist/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-log.txt

